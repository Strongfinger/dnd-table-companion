# Firebase web config for the live lobby (PUBLIC "publishable" values, protected by
# database.rules.json). Copy this file to .env.local and fill in your project's values.
# On Vercel: Project → Settings → Environment Variables (same names).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
